# ---- Build Stage ----
FROM node:22.22.2-alpine@sha256:8ea2348b068a9544dae7317b4f3aafcdc032df1647bb7d768a05a5cad1a7683f AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# ---- Serve Stage ----
FROM nginxinc/nginx-unprivileged:alpine@sha256:901e944d1f4fc2bd077e8f5568b98c1f6f8cdacf6b97a87747c43134a339b9a7
ARG NGINX_CONFIG=nginx.conf
USER root
# Bind the ARM and x86 packages independently; the pinned ARM base has old PCRE2.
RUN set -eux; \
    case "$(cat /etc/alpine-release)" in 3.24.*) ;; *) exit 1 ;; esac; \
    case "$(apk --print-arch)" in \
      x86_64) package_sha=2919897914820f42a17a8d7d37df310d2dfad1c82ebe5f539cc5c765f916752a ;; \
      aarch64) package_sha=03efd0b29f7f38deb10a9ccb54f56e19683eb7ac27eb1f347e6dbd2e59ea000d ;; \
      *) exit 1 ;; \
    esac; \
    wget -O /tmp/pcre2.apk "https://dl-cdn.alpinelinux.org/alpine/v3.24/main/$(apk --print-arch)/pcre2-10.49-r0.apk"; \
    echo "$package_sha  /tmp/pcre2.apk" | sha256sum -c -; \
    apk add --no-network /tmp/pcre2.apk; \
    test "$(awk '$0=="P:pcre2"{p=1;next} p && /^V:/{print substr($0,3);exit}' /lib/apk/db/installed)" = 10.49-r0; \
    rm /tmp/pcre2.apk
# Use checksummed APKs directly: a stale mirror index must not downgrade OpenSSL.
RUN set -eux; \
    case "$(cat /etc/alpine-release)" in 3.24.*) ;; *) exit 1 ;; esac; \
    arch="$(apk --print-arch)"; \
    case "$arch" in \
      x86_64) crypto_sha=6632d758d8f5e9ea3b650fe966f23bbf9a202f8b8dceecac93da135dec5e3689; ssl_sha=05e3393fb95aa5751ca2f9d242f659f6cff82c1cc7767cc2df4a086f7ad01877 ;; \
      aarch64) crypto_sha=2676a2b0b6e23ea2edccf3ee982b9842a665d52603d047de3d0a185dc316d983; ssl_sha=20ac252b276d73f2c69c1d25f84537c7fba81caefc026c6be1094b394af2082e ;; \
      *) exit 1 ;; \
    esac; \
    wget -O /tmp/libcrypto3-3.5.9-r0.apk "https://dl-cdn.alpinelinux.org/alpine/v3.24/main/$arch/libcrypto3-3.5.9-r0.apk"; \
    echo "$crypto_sha  /tmp/libcrypto3-3.5.9-r0.apk" | sha256sum -c -; \
    wget -O /tmp/libssl3-3.5.9-r0.apk "https://dl-cdn.alpinelinux.org/alpine/v3.24/main/$arch/libssl3-3.5.9-r0.apk"; \
    echo "$ssl_sha  /tmp/libssl3-3.5.9-r0.apk" | sha256sum -c -; \
    apk add --no-network /tmp/libcrypto3-3.5.9-r0.apk /tmp/libssl3-3.5.9-r0.apk; \
    rm /tmp/libcrypto3-3.5.9-r0.apk /tmp/libssl3-3.5.9-r0.apk
# The immutable base predates Alpine fixes for the OpenSSL, Expat, and TIFF findings
# enforced by the deployable-image scan gate.
# Preserve signed security APKs: CDN regions can disagree on availability.
COPY vendor/alpine/v3.24/ /tmp/diva-security/
RUN set -eux; \
    arch="$(apk --print-arch)"; \
    case "$arch" in \
      x86_64) expat_sha=32b127f31e0a919110a18a7f0bb3780d8fb66ba4d8d61b2d301d633f0e319d0e; x11_sha=016efc189c6d566061ffe206ed0780e32686c1a8c832a3917d35d2c66d61a40f; brotli_sha=62a7e37e43bbfc1f8525a00ad2125fd5897135dc93b849733884cb78ffd8e26c; curl_sha=531ae298451a4c1c44f563fc3b2eedc2c1d7e0a26a33bdfc0efe6faaff6a5942; libcurl_sha=1f70ca404818805a6465b615bbfe84ef861488a963d7e630108ebd7fbaa51665 ;; \
      aarch64) expat_sha=7128bfe18b8a315b9cf90ddf0beffeee454648ae72ff7898ff7d7b09803a559d; x11_sha=d460c111c1fc40e8f84367907b3e50a58a2b19c3e9d54f7c1f0e4aea7a376e3b; brotli_sha=f802b9d5a329c216f02e73607cb8f662c434767e41686367ac0afcf6d0d45d64; curl_sha=3748c544ab475033cb028e415858b8a671ca7d43756e0149732c860588882ced; libcurl_sha=64ae89f6e5d318ed5209778232191806ce49644ce9e09540b7d7830a5330d127 ;; \
      *) exit 1 ;; \
    esac; \
    echo "$expat_sha  /tmp/diva-security/$arch/libexpat-2.9.0-r0.apk" | sha256sum -c -; \
    echo "$x11_sha  /tmp/diva-security/$arch/libx11-1.8.14-r0.apk" | sha256sum -c -; \
    echo "$brotli_sha  /tmp/diva-security/$arch/brotli-libs-1.2.1-r0.apk" | sha256sum -c -; \
    echo "$curl_sha  /tmp/diva-security/$arch/curl-8.23.0-r0.apk" | sha256sum -c -; \
    echo "$libcurl_sha  /tmp/diva-security/$arch/libcurl-8.23.0-r0.apk" | sha256sum -c -; \
    apk add --no-network "/tmp/diva-security/$arch/libexpat-2.9.0-r0.apk" "/tmp/diva-security/$arch/libx11-1.8.14-r0.apk" "/tmp/diva-security/$arch/brotli-libs-1.2.1-r0.apk" "/tmp/diva-security/$arch/curl-8.23.0-r0.apk" "/tmp/diva-security/$arch/libcurl-8.23.0-r0.apk"; \
    rm -r /tmp/diva-security
RUN apk update && \
    apk add --no-cache \
      curl=8.23.0-r0 \
      libcurl=8.23.0-r0 \
      brotli-libs=1.2.1-r0 \
      libcrypto3=3.5.9-r0 \
      libssl3=3.5.9-r0 \
      libexpat=2.9.0-r0 \
      libx11=1.8.14-r0 \
      libuuid=2.42.3-r1 \
      tiff=4.7.2-r0 && \
    test "$(awk '$0=="P:tiff"{p=1;next} p && /^V:/{print substr($0,3);exit}' /lib/apk/db/installed)" = 4.7.2-r0
COPY --from=build /app/dist /usr/share/nginx/html/diva-player
COPY --chown=101:101 ${NGINX_CONFIG} /etc/nginx/conf.d/default.conf
RUN chmod 0644 /etc/nginx/conf.d/default.conf
USER 101:101
EXPOSE 8080 18080
