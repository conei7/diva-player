# ---- Build Stage ----
FROM node:22.22.2-alpine@sha256:8ea2348b068a9544dae7317b4f3aafcdc032df1647bb7d768a05a5cad1a7683f AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# ---- Serve Stage ----
FROM nginxinc/nginx-unprivileged:alpine@sha256:901e944d1f4fc2bd077e8f5568b98c1f6f8cdacf6b97a87747c43134a339b9a7
ARG NGINX_CONFIG=nginx.conf
USER root
# Bind the ARM and x86 packages independently; the pinned ARM base has old PCRE2.
RUN set -eux; \
    case "$(cat /etc/alpine-release)" in 3.24.*) ;; *) exit 1 ;; esac; \
    case "$(apk --print-arch)" in \
      x86_64) package_sha=2919897914820f42a17a8d7d37df310d2dfad1c82ebe5f539cc5c765f916752a ;; \
      aarch64) package_sha=03efd0b29f7f38deb10a9ccb54f56e19683eb7ac27eb1f347e6dbd2e59ea000d ;; \
      *) exit 1 ;; \
    esac; \
    wget -O /tmp/pcre2.apk "https://dl-cdn.alpinelinux.org/alpine/v3.24/main/$(apk --print-arch)/pcre2-10.49-r0.apk"; \
    echo "$package_sha  /tmp/pcre2.apk" | sha256sum -c -; \
    apk add --no-network /tmp/pcre2.apk; \
    test "$(apk info -v pcre2)" = pcre2-10.49-r0; \
    rm /tmp/pcre2.apk
# Use checksummed APKs directly: a stale mirror index must not downgrade OpenSSL.
RUN set -eux; \
    case "$(cat /etc/alpine-release)" in 3.24.*) ;; *) exit 1 ;; esac; \
    arch="$(apk --print-arch)"; \
    case "$arch" in \
      x86_64) crypto_sha=6632d758d8f5e9ea3b650fe966f23bbf9a202f8b8dceecac93da135dec5e3689; ssl_sha=05e3393fb95aa5751ca2f9d242f659f6cff82c1cc7767cc2df4a086f7ad01877 ;; \
      aarch64) crypto_sha=2676a2b0b6e23ea2edccf3ee982b9842a665d52603d047de3d0a185dc316d983; ssl_sha=20ac252b276d73f2c69c1d25f84537c7fba81caefc026c6be1094b394af2082e ;; \
      *) exit 1 ;; \
    esac; \
    wget -O /tmp/libcrypto3-3.5.9-r0.apk "https://dl-cdn.alpinelinux.org/alpine/v3.24/main/$arch/libcrypto3-3.5.9-r0.apk"; \
    echo "$crypto_sha  /tmp/libcrypto3-3.5.9-r0.apk" | sha256sum -c -; \
    wget -O /tmp/libssl3-3.5.9-r0.apk "https://dl-cdn.alpinelinux.org/alpine/v3.24/main/$arch/libssl3-3.5.9-r0.apk"; \
    echo "$ssl_sha  /tmp/libssl3-3.5.9-r0.apk" | sha256sum -c -; \
    apk add --no-network /tmp/libcrypto3-3.5.9-r0.apk /tmp/libssl3-3.5.9-r0.apk; \
    rm /tmp/libcrypto3-3.5.9-r0.apk /tmp/libssl3-3.5.9-r0.apk
# The immutable base predates Alpine fixes for the OpenSSL and Expat findings
# enforced by the deployable-image scan gate.
RUN apk update && \
    apk add --no-cache \
      libcrypto3=3.5.9-r0 \
      libssl3=3.5.9-r0 \
      libexpat=2.8.5-r0 \
      libuuid=2.42.3-r1
COPY --from=build /app/dist /usr/share/nginx/html/diva-player
COPY --chown=101:101 ${NGINX_CONFIG} /etc/nginx/conf.d/default.conf
RUN chmod 0644 /etc/nginx/conf.d/default.conf
USER 101:101
EXPOSE 8080 18080
