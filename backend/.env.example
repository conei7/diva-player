# .env ファイルのテンプレート
# backend/.env にコピーして使用してください

# Compose refuses to start until every secret below is supplied in backend/.env.
# Use unique, randomly generated values. Never copy production values here.
DIVA_DB_ADMIN_USER=vocadb
DIVA_DB_ADMIN_PASSWORD=replace-with-a-random-admin-password
DIVA_API_DB_USER=diva_api_login_local_v1
DIVA_API_DB_PASSWORD=replace-with-a-different-random-api-password
PAGES_PROXY_KEY=replace-with-a-separate-random-local-proxy-key

# Per API slot. Request-originated database connections are capped at
# Maximum Pool Size minus this reserve, independently of internal fan-out.
DIVA_API_AGGREGATE_CONCURRENCY=6
DIVA_API_DB_CONNECTION_RESERVE=4
DIVA_API_HEAVY_CONCURRENCY=6
DIVA_API_HEAVY_QUEUE=6
DIVA_API_STANDARD_CONCURRENCY=6
DIVA_API_STANDARD_QUEUE=8
DIVA_API_PROVIDER_CONCURRENCY=2
DIVA_API_PROVIDER_QUEUE=2
DIVA_API_QUEUE_TIMEOUT_MS=1500

QDRANT_URL=http://localhost:6333
