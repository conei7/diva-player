# .env ファイルのテンプレート
# backend/.env にコピーして使用してください

# Compose refuses to start until every secret below is supplied in backend/.env.
# Use unique, randomly generated values. Never copy production values here.
DIVA_DB_ADMIN_USER=vocadb
DIVA_DB_ADMIN_PASSWORD=replace-with-a-random-admin-password
DIVA_API_DB_USER=diva_api_login_YYYYMMDD
DIVA_API_DB_PASSWORD=replace-with-a-different-random-api-password
PAGES_PROXY_KEY=replace-with-the-existing-pages-proxy-key

QDRANT_URL=http://localhost:6333
