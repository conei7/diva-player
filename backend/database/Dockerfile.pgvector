FROM postgres:16-alpine3.23@sha256:421b84e07a72bb8f3715f20501a1fdbe1219aad1fa4af7786a49d9a3f2480296 AS pgvector-builder

ARG PGVECTOR_COMMIT=8ee86c96f0fd72390f890aa8a336fda6d3ab4c6c
ARG PGVECTOR_ARCHIVE_SHA256=d076a3098010905fd60256649327809651f6288327db6413f0938305f62ea299
RUN apk add --no-cache \
      build-base=0.5-r3 \
      postgresql16-dev=16.15-r0
RUN set -eux; \
    [ "$PGVECTOR_COMMIT" = 8ee86c96f0fd72390f890aa8a336fda6d3ab4c6c ]; \
    [ "$PGVECTOR_ARCHIVE_SHA256" = d076a3098010905fd60256649327809651f6288327db6413f0938305f62ea299 ]; \
    wget -O /tmp/pgvector.tar.gz \
      "https://github.com/pgvector/pgvector/archive/$PGVECTOR_COMMIT.tar.gz"; \
    echo "$PGVECTOR_ARCHIVE_SHA256  /tmp/pgvector.tar.gz" | sha256sum -c -; \
    mkdir -p /tmp/pgvector /opt/pgvector/usr/local/lib/postgresql \
      /opt/pgvector/usr/local/share/postgresql/extension; \
    tar -xzf /tmp/pgvector.tar.gz --strip-components=1 -C /tmp/pgvector; \
    grep -Fx 'EXTVERSION = 0.8.6' /tmp/pgvector/Makefile; \
    grep -Fx "default_version = '0.8.6'" /tmp/pgvector/vector.control; \
    make -C /tmp/pgvector OPTFLAGS= PG_CONFIG=/usr/bin/pg_config \
      PGXS=/usr/lib/postgresql16/pgxs/src/makefiles/pgxs.mk; \
    install -m 0555 /tmp/pgvector/vector.so \
      /opt/pgvector/usr/local/lib/postgresql/vector.so; \
    install -m 0444 /tmp/pgvector/vector.control \
      /opt/pgvector/usr/local/share/postgresql/extension/vector.control; \
    find /tmp/pgvector/sql -maxdepth 1 -type f -name 'vector--*.sql' \
      -exec install -m 0444 '{}' /opt/pgvector/usr/local/share/postgresql/extension/ \;; \
    test -s /opt/pgvector/usr/local/lib/postgresql/vector.so; \
    test -s /opt/pgvector/usr/local/share/postgresql/extension/vector--0.8.6.sql; \
    (cd /opt/pgvector && find usr -type f -print0 | sort -z \
      | xargs -0 sha256sum -b > pgvector-files.sha256)

FROM postgres:16-alpine3.23@sha256:421b84e07a72bb8f3715f20501a1fdbe1219aad1fa4af7786a49d9a3f2480296

ARG DIVA_POSTGRES_DOCKERFILE_SHA256
ARG DIVA_POSTGRES_BUILD_TIMESTAMP
ARG DIVA_POSTGRES_SCHEMA_SHA256
ARG DIVA_POSTGRES_SOURCE_BUNDLE_SHA256
RUN set -eux; \
    printf '%s\n' "$DIVA_POSTGRES_DOCKERFILE_SHA256" \
      | grep -Eq '^[0-9a-f]{64}$'; \
    printf '%s\n' "$DIVA_POSTGRES_SCHEMA_SHA256" \
      | grep -Eq '^[0-9a-f]{64}$'; \
    printf '%s\n' "$DIVA_POSTGRES_SOURCE_BUNDLE_SHA256" \
      | grep -Eq '^[0-9a-f]{64}$'; \
    printf '%s\n' "$DIVA_POSTGRES_BUILD_TIMESTAMP" \
      | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'; \
    apk add --no-cache \
      libcrypto3=3.5.8-r0 \
      libssl3=3.5.8-r0 \
      libuuid=2.41.6-r0 \
      su-exec=0.3-r0; \
    test -L /usr/local/bin/su-exec; \
    [ "$(readlink /usr/local/bin/su-exec)" = gosu ]; \
    [ "$(stat -c '%u:%g' /usr/local/bin/su-exec)" = 0:0 ]; \
    rm /usr/local/bin/su-exec; \
    [ "$(command -v su-exec)" = /sbin/su-exec ]; \
    test -f /sbin/su-exec; \
    test ! -L /sbin/su-exec; \
    [ "$(stat -c '%u:%g:%a' /sbin/su-exec)" = 0:0:755 ]; \
    test -f /usr/local/bin/docker-entrypoint.sh; \
    test ! -L /usr/local/bin/docker-entrypoint.sh; \
    [ "$(stat -c '%u:%g:%a' /usr/local/bin/docker-entrypoint.sh)" = 0:0:755 ]; \
    [ "$(sha256sum /usr/local/bin/docker-entrypoint.sh | awk '{print $1}')" \
      = 9c440299ae04a0a79d55b8bf03307036d890a40979d2fb698073c9050d4b20a5 ]; \
    test -f /usr/local/bin/gosu; \
    test ! -L /usr/local/bin/gosu; \
    [ "$(stat -c '%u:%g:%a' /usr/local/bin/gosu)" = 0:0:755 ]; \
    sed -i 's/exec gosu postgres/exec su-exec postgres/' \
      /usr/local/bin/docker-entrypoint.sh; \
    sed -i \
      's/\\! -user postgres -exec chown postgres/\\( \\! -user postgres -o \\! -group postgres \\) -exec chown postgres:postgres/g' \
      /usr/local/bin/docker-entrypoint.sh; \
    [ "$(grep -Ec '^[[:space:]]*exec su-exec postgres "\$BASH_SOURCE" "\$@"$' \
      /usr/local/bin/docker-entrypoint.sh)" = 1 ]; \
    [ "$(grep -Fc -- '\! -group postgres' \
      /usr/local/bin/docker-entrypoint.sh)" = 3 ]; \
    ! grep -F 'gosu' /usr/local/bin/docker-entrypoint.sh; \
    test -f /usr/local/bin/docker-entrypoint.sh; \
    test ! -L /usr/local/bin/docker-entrypoint.sh; \
    [ "$(stat -c '%u:%g:%a' /usr/local/bin/docker-entrypoint.sh)" = 0:0:755 ]; \
    rm -f /usr/local/bin/gosu; \
    ! command -v gosu; \
    test ! -L /usr/local/bin/gosu; \
    test ! -e /usr/local/bin/su-exec; \
    test ! -L /usr/local/bin/su-exec; \
    sed -i 's/^postgres:x:70:70:/postgres:x:999:999:/' /etc/passwd; \
    sed -i 's/^postgres:x:70:/postgres:x:999:/' /etc/group; \
    [ "$(id -u postgres):$(id -g postgres)" = 999:999 ]; \
    find /var/lib/postgresql /var/run/postgresql -xdev \
      \( -user 70 -o -group 70 \) \
      -exec chown 999:999 '{}' +; \
    legacy_owner="$(find /var/lib/postgresql /var/run/postgresql -xdev \
      \( -user 70 -o -group 70 \) -print -quit)"; \
    [ -z "$legacy_owner" ]; \
    install -d -o 0 -g 0 -m 0755 /usr/share/diva-postgres; \
    apk info -vv | LC_ALL=C sort > /usr/share/diva-postgres/runtime-packages.txt; \
    chmod 0444 /usr/share/diva-postgres/runtime-packages.txt; \
    test ! -e /usr/local/bin/gosu
COPY --from=pgvector-builder --chown=0:0 /opt/pgvector/usr/ /usr/
COPY --from=pgvector-builder --chown=0:0 /opt/pgvector/pgvector-files.sha256 \
    /usr/share/diva-postgres/pgvector-files.sha256
COPY --chown=0:0 schema.sql /docker-entrypoint-initdb.d/01_schema.sql
RUN set -eux; \
    test -f /docker-entrypoint-initdb.d/01_schema.sql; \
    test ! -L /docker-entrypoint-initdb.d/01_schema.sql; \
    [ "$(stat -c '%u:%g' /docker-entrypoint-initdb.d/01_schema.sql)" = 0:0 ]; \
    [ "$(sha256sum /docker-entrypoint-initdb.d/01_schema.sql | awk '{print $1}')" \
      = "$DIVA_POSTGRES_SCHEMA_SHA256" ]; \
    chmod 0444 /docker-entrypoint-initdb.d/01_schema.sql; \
    cd /; \
    sha256sum -c /usr/share/diva-postgres/pgvector-files.sha256; \
    case "$(apk --print-arch)" in \
      x86_64) vector_libc=libc.musl-x86_64.so.1 ;; \
      aarch64) vector_libc=libc.musl-aarch64.so.1 ;; \
      *) echo "unsupported architecture: $(apk --print-arch)" >&2; exit 1 ;; \
    esac; \
    [ "$(scanelf --needed --nobanner --format '%n' \
      /usr/local/lib/postgresql/vector.so | awk '{print $1}')" \
      = "$vector_libc" ]; \
    test "$(/usr/local/bin/postgres --version)" = 'postgres (PostgreSQL) 16.15'; \
    test -s /usr/local/share/postgresql/extension/vector--0.8.6.sql; \
    printf '%s\n' \
      "dockerfile.sha256=$DIVA_POSTGRES_DOCKERFILE_SHA256" \
      'pgvector.archive.sha256=d076a3098010905fd60256649327809651f6288327db6413f0938305f62ea299' \
      'pgvector.commit=8ee86c96f0fd72390f890aa8a336fda6d3ab4c6c' \
      "schema.sha256=$DIVA_POSTGRES_SCHEMA_SHA256" \
      > /usr/share/diva-postgres/source-bundle.attestation; \
    [ "$(sha256sum /usr/share/diva-postgres/source-bundle.attestation \
      | awk '{print $1}')" = "$DIVA_POSTGRES_SOURCE_BUNDLE_SHA256" ]; \
    chmod 0444 /usr/share/diva-postgres/pgvector-files.sha256 \
      /usr/share/diva-postgres/source-bundle.attestation
LABEL com.diva.postgres.base-digest="sha256:421b84e07a72bb8f3715f20501a1fdbe1219aad1fa4af7786a49d9a3f2480296" \
      com.diva.postgres.pg-major="16" \
      com.diva.postgres.pg-version="16.15" \
      com.diva.postgres.pgvector-version="0.8.6" \
      com.diva.postgres.pgvector-commit="8ee86c96f0fd72390f890aa8a336fda6d3ab4c6c" \
      com.diva.postgres.dockerfile-sha256="${DIVA_POSTGRES_DOCKERFILE_SHA256}" \
      com.diva.postgres.schema-sha256="${DIVA_POSTGRES_SCHEMA_SHA256}" \
      com.diva.postgres.source-bundle-sha256="${DIVA_POSTGRES_SOURCE_BUNDLE_SHA256}" \
      com.diva.postgres.build-timestamp="${DIVA_POSTGRES_BUILD_TIMESTAMP}" \
      com.diva.postgres.runtime-contract="alpine-root-init-su-exec-uid999-v1"
