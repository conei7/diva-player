FROM alpine:3.23.3@sha256:25109184c71bdad752c8312a8623239686a9a2071e8825f20acb8f2198c3f659

ARG DIVA_POSTGRES_MIGRATE_DOCKERFILE_SHA256
ARG DIVA_POSTGRES_MIGRATE_BUILD_TIMESTAMP
# Use checksummed APKs directly: stale indexes must not downgrade security fixes.
RUN set -eux; \
    case "$(cat /etc/alpine-release)" in 3.23.*) ;; *) exit 1 ;; esac; \
    arch="$(apk --print-arch)"; \
    case "$arch" in \
      x86_64) crypto_sha=d155b548ac35f48823acc704184baa463bd86c4f59ea93aca5e8120f98902c9f; ssl_sha=4048fc08e315f235f3c7cf8b89532cfcb167edbb343299b158761966ad101b17; zlib_sha=22ff5ae6b704ac1786d6565dcb3f5dde489e44a5038297a565382b76f656ee08 ;; \
      aarch64) crypto_sha=719af95f8e01494aa8dd0e06e3af6d0eaf96cb816d13c52c81628e2780c1adae; ssl_sha=c6e06484ab80e8c575b4c3c0e0cea34b350d8cbd35406e59e186ee1a3e0ebedf; zlib_sha=c9bc3c75104ffba5785277b38eb83bf90ea83539e3bb26c617864fb78dcb4462 ;; \
      *) exit 1 ;; \
    esac; \
    wget -O /tmp/libcrypto3-3.5.9-r1.apk "https://dl-cdn.alpinelinux.org/alpine/v3.23/main/$arch/libcrypto3-3.5.9-r1.apk"; \
    echo "$crypto_sha  /tmp/libcrypto3-3.5.9-r1.apk" | sha256sum -c -; \
    wget -O /tmp/libssl3-3.5.9-r1.apk "https://dl-cdn.alpinelinux.org/alpine/v3.23/main/$arch/libssl3-3.5.9-r1.apk"; \
    echo "$ssl_sha  /tmp/libssl3-3.5.9-r1.apk" | sha256sum -c -; \
    wget -O /tmp/zlib-1.4-r0.apk "https://dl-cdn.alpinelinux.org/alpine/v3.23/main/$arch/zlib-1.4-r0.apk"; \
    echo "$zlib_sha  /tmp/zlib-1.4-r0.apk" | sha256sum -c -; \
    apk add --no-network /tmp/libcrypto3-3.5.9-r1.apk /tmp/libssl3-3.5.9-r1.apk /tmp/zlib-1.4-r0.apk; \
    rm /tmp/libcrypto3-3.5.9-r1.apk /tmp/libssl3-3.5.9-r1.apk /tmp/zlib-1.4-r0.apk
# The official APKs can be available before a CDN's package index catches up.
RUN set -eux; \
    arch="$(apk --print-arch)"; \
    case "$arch" in \
      x86_64) musl_sha=d49d703392f1a6d2fe822db1b57e61735063077e1ad846d5f40d79fe507ec727; utils_sha=ee9a8106067ead36b8930f5ccdb3e515574871ac8e07f88cc7bab7049effc945 ;; \
      aarch64) musl_sha=d7043c549029c98d438e9bc94213b006e5c88540eb58d1f5b0f0d1d56dbf9c98; utils_sha=df4a9a4bb81a76af36779d2c5ef28ac5a1778670788bb4cd152def522904df8f ;; \
      *) exit 1 ;; \
    esac; \
    wget -O /tmp/musl.apk "https://dl-cdn.alpinelinux.org/alpine/v3.23/main/$arch/musl-1.2.5-r24.apk"; \
    echo "$musl_sha  /tmp/musl.apk" | sha256sum -c -; \
    wget -O /tmp/musl-utils.apk "https://dl-cdn.alpinelinux.org/alpine/v3.23/main/$arch/musl-utils-1.2.5-r24.apk"; \
    echo "$utils_sha  /tmp/musl-utils.apk" | sha256sum -c -; \
    apk add --no-network /tmp/musl.apk /tmp/musl-utils.apk; \
    rm /tmp/musl.apk /tmp/musl-utils.apk
RUN set -eux; \
    printf '%s\n' "$DIVA_POSTGRES_MIGRATE_DOCKERFILE_SHA256" \
      | grep -Eq '^[0-9a-f]{64}$'; \
    printf '%s\n' "$DIVA_POSTGRES_MIGRATE_BUILD_TIMESTAMP" \
      | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'; \
    apk add --no-cache \
      musl=1.2.5-r24 \
      musl-utils=1.2.5-r24 \
      postgresql16-client=16.16-r0; \
    for package_version in 'libcrypto3:3.5.9-r1' 'libssl3:3.5.9-r1' 'zlib:1.4-r0'; do \
      package="${package_version%%:*}"; version="${package_version#*:}"; \
      awk -F: -v package="$package" -v version="$version" \
        '$1 == "P" { installed = ($2 == package); next } installed && $1 == "V" { if ($2 == version) found = 1; exit } END { exit !found }' \
        /lib/apk/db/installed; \
    done; \
    install -d -o 0 -g 0 -m 0755 /usr/share/diva-postgres-migrate; \
    apk info -vv | LC_ALL=C sort \
      > /usr/share/diva-postgres-migrate/runtime-packages.txt; \
    chmod 0444 /usr/share/diva-postgres-migrate/runtime-packages.txt; \
    test "$(psql --version)" = 'psql (PostgreSQL) 16.16'; \
    test ! -e /usr/local/bin/gosu; \
    case "$(apk --print-arch)" in x86_64|aarch64) ;; *) exit 1 ;; esac
ENV HOME=/tmp
USER 65534:65534
ENTRYPOINT ["psql"]
LABEL com.diva.postgres-migrate.base-digest="sha256:25109184c71bdad752c8312a8623239686a9a2071e8825f20acb8f2198c3f659" \
      com.diva.postgres-migrate.pg-major="16" \
      com.diva.postgres-migrate.pg-version="16.16" \
      com.diva.postgres-migrate.dockerfile-sha256="${DIVA_POSTGRES_MIGRATE_DOCKERFILE_SHA256}" \
      com.diva.postgres-migrate.build-timestamp="${DIVA_POSTGRES_MIGRATE_BUILD_TIMESTAMP}" \
      com.diva.postgres-migrate.runtime-contract="rootless-readonly-psql-client-v1"
