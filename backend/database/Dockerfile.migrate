FROM alpine:3.23.3@sha256:25109184c71bdad752c8312a8623239686a9a2071e8825f20acb8f2198c3f659

ARG DIVA_POSTGRES_MIGRATE_DOCKERFILE_SHA256
ARG DIVA_POSTGRES_MIGRATE_BUILD_TIMESTAMP
# Use checksummed APKs directly: a stale mirror index must not downgrade OpenSSL or zlib.
RUN set -eux; \
    case "$(cat /etc/alpine-release)" in 3.23.*) ;; *) exit 1 ;; esac; \
    arch="$(apk --print-arch)"; \
    case "$arch" in \
      x86_64) crypto_sha=9c82c86f051f3372445ecdbae5068ccc39dbc423ba8f779eaa84549fef1cfc77; ssl_sha=b5ad11f5955b3b7ddfd8c32e8c1fdd79878d208bb4dfa9bbd8f35ddc59187242; zlib_sha=ee62e1864c235901e2aa4d1868c7ae8f7cc5d0740a98c48a2525332eb4bfda73 ;; \
      aarch64) crypto_sha=3b0bd7aaac36d49216f47d025f303dafb6da8d05bd258f71900d3b6156d36012; ssl_sha=cdb3762116994f767cd1da423fa8004bd36b2e3802e3a1343786a40f00a5030e; zlib_sha=82d52fa82a46c73aae8b9f95d7f31a196137f3ce4a000980cdbbfc05c245e7bf ;; \
      *) exit 1 ;; \
    esac; \
    wget -O /tmp/libcrypto3-3.5.9-r0.apk "https://dl-cdn.alpinelinux.org/alpine/v3.23/main/$arch/libcrypto3-3.5.9-r0.apk"; \
    echo "$crypto_sha  /tmp/libcrypto3-3.5.9-r0.apk" | sha256sum -c -; \
    wget -O /tmp/libssl3-3.5.9-r0.apk "https://dl-cdn.alpinelinux.org/alpine/v3.23/main/$arch/libssl3-3.5.9-r0.apk"; \
    echo "$ssl_sha  /tmp/libssl3-3.5.9-r0.apk" | sha256sum -c -; \
    wget -O /tmp/zlib-1.3.2-r1.apk "https://dl-cdn.alpinelinux.org/alpine/v3.23/main/$arch/zlib-1.3.2-r1.apk"; \
    echo "$zlib_sha  /tmp/zlib-1.3.2-r1.apk" | sha256sum -c -; \
    apk add --no-network /tmp/libcrypto3-3.5.9-r0.apk /tmp/libssl3-3.5.9-r0.apk /tmp/zlib-1.3.2-r1.apk; \
    rm /tmp/libcrypto3-3.5.9-r0.apk /tmp/libssl3-3.5.9-r0.apk /tmp/zlib-1.3.2-r1.apk
RUN set -eux; \
    printf '%s\n' "$DIVA_POSTGRES_MIGRATE_DOCKERFILE_SHA256" \
      | grep -Eq '^[0-9a-f]{64}$'; \
    printf '%s\n' "$DIVA_POSTGRES_MIGRATE_BUILD_TIMESTAMP" \
      | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'; \
    apk add --no-cache \
      musl=1.2.5-r23 \
      musl-utils=1.2.5-r23 \
      postgresql16-client=16.15-r0; \
    for package_version in 'libcrypto3:3.5.9-r0' 'libssl3:3.5.9-r0' 'zlib:1.3.2-r1'; do \
      package="${package_version%%:*}"; version="${package_version#*:}"; \
      awk -F: -v package="$package" -v version="$version" \
        '$1 == "P" { installed = ($2 == package); next } installed && $1 == "V" { if ($2 == version) found = 1; exit } END { exit !found }' \
        /lib/apk/db/installed; \
    done; \
    install -d -o 0 -g 0 -m 0755 /usr/share/diva-postgres-migrate; \
    apk info -vv | LC_ALL=C sort \
      > /usr/share/diva-postgres-migrate/runtime-packages.txt; \
    chmod 0444 /usr/share/diva-postgres-migrate/runtime-packages.txt; \
    test "$(psql --version)" = 'psql (PostgreSQL) 16.15'; \
    test ! -e /usr/local/bin/gosu; \
    case "$(apk --print-arch)" in x86_64|aarch64) ;; *) exit 1 ;; esac
ENV HOME=/tmp
USER 65534:65534
ENTRYPOINT ["psql"]
LABEL com.diva.postgres-migrate.base-digest="sha256:25109184c71bdad752c8312a8623239686a9a2071e8825f20acb8f2198c3f659" \
      com.diva.postgres-migrate.pg-major="16" \
      com.diva.postgres-migrate.pg-version="16.15" \
      com.diva.postgres-migrate.dockerfile-sha256="${DIVA_POSTGRES_MIGRATE_DOCKERFILE_SHA256}" \
      com.diva.postgres-migrate.build-timestamp="${DIVA_POSTGRES_MIGRATE_BUILD_TIMESTAMP}" \
      com.diva.postgres-migrate.runtime-contract="rootless-readonly-psql-client-v1"
