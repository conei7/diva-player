[Unit]
Description=Run DIVA Player runtime health snapshot every minute

[Timer]
OnBootSec=2min
OnUnitActiveSec=60s
# Avoid systemd default timer coalescing, which can defer the nominal 1-minute probe by up to 1 minute.
AccuracySec=1s
Persistent=true
Unit=diva-runtime-health.service

[Install]
WantedBy=timers.target
